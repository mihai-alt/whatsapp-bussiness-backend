PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp_bsp
# Set true for Aiven / cloud MySQL with ssl-mode=REQUIRED
DB_SSL=false

# Prefer REDIS_URL on Render / managed Redis; otherwise use host/port/password
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# SMTP (backend only — never expose to React)
# Gmail: SMTP_PROVIDER=gmail + App Password
# Outlook: SMTP_PROVIDER=outlook
# Yahoo: SMTP_PROVIDER=yahoo
# Or set SMTP_HOST manually for any provider
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Legacy aliases: SMTP_PASS, SMTP_FROM

# Resend HTTPS (recommended on Render Free — SMTP ports 25/465/587 are blocked)
# Create key at https://resend.com → API Keys
RESEND_API_KEY=
# Test from-address (or your verified domain address)
RESEND_FROM=onboarding@resend.dev

META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=whatsapp_verify_token
META_GRAPH_VERSION=v21.0
META_SYSTEM_USER_TOKEN=
META_TOKEN_ENCRYPTION_KEY=
META_REDIRECT_URI=

UPLOAD_DIR=uploads
DEFAULT_MESSAGE_COST=0.50
LOW_WALLET_THRESHOLD=100
WALLET_MIN_RECHARGE=100
WALLET_MAX_RECHARGE=100000
WALLET_CURRENCY=INR
WALLET_PROCESSING_FEE=0
WALLET_PROCESSING_FEE_PERCENT=0
DEFAULT_PROVIDER_COST=0
CAMPAIGN_CONCURRENCY=5
CAMPAIGN_SEND_DELAY_MS=100

# Razorpay (use TEST keys from https://dashboard.razorpay.com — never commit real secrets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
